---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { posts, formatDate } from "../../lib/blog";
import { translations } from "../../lib/i18n";

const t = translations.es;
---

<BaseLayout title={t.meta.blogTitle} description={t.meta.blogDescription} lang="es" basePath="/blog.html">
  <Nav t={t} locale="es" basePath="/blog.html" />
  <main>
    <div class="page-head section">
      <div class="container">
        <p class="sec-label reveal"><span>//</span> {t.blog.label}</p>
        <h1 class="sec-title reveal">{t.blog.title}</h1>
        <p class="page-sub reveal">{t.blog.sub}</p>
      </div>
    </div>

    <section class="section">
      <div class="container">
        <div class="sort-row reveal">
          <button
            class="sort-toggle"
            id="sort-toggle"
            type="button"
            data-newest={t.blog.newest}
            data-oldest={t.blog.oldest}
          >{t.blog.newest}</button>
        </div>

        <div class="posts" id="posts">
          {posts.map((post) => (
            <a
              class="post-card reveal"
              href={post.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="post-top">
                <time class="post-date" datetime={post.date}>{formatDate(post.date, "es-MX")}</time>
                <span class="post-source">LinkedIn &nearr;</span>
              </div>
              <h2>{post.title}</h2>
              <p class="post-desc">{post.description}</p>
              <div class="post-tags">
                {post.tags.map((tag) => (
                  <span class="post-tag">{t.blog.tagLabels[tag] ?? tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} />

  <script>
    const postsEl = document.getElementById("posts");
    const toggle = document.getElementById("sort-toggle");
    if (postsEl && toggle) {
      let newestFirst = true;
      toggle.addEventListener("click", () => {
        newestFirst = !newestFirst;
        const cards = Array.from(postsEl.querySelectorAll(".post-card"));
        cards.sort((a, b) => {
          const da = a.querySelector("time")?.getAttribute("datetime") ?? "";
          const db = b.querySelector("time")?.getAttribute("datetime") ?? "";
          return newestFirst ? db.localeCompare(da) : da.localeCompare(db);
        });
        cards.forEach((card) => postsEl.appendChild(card));
        toggle.textContent = newestFirst ? toggle.dataset.newest : toggle.dataset.oldest;
      });
    }
  </script>
</BaseLayout>
