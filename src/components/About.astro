---
import type { Translation } from "../lib/i18n";

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="about" class="section">
  <div class="container">
    <p class="sec-label reveal"><span>//</span> {t.sections.aboutLabel}</p>
    <h2 class="sec-title reveal">{t.sections.aboutTitle}</h2>

    <p class="about-mission reveal">{t.about.mission}</p>
    <p class="about-body reveal">
      {t.about.body}
    </p>

    <div class="about-meta reveal">
      <span><strong>{t.about.currently}</strong> {t.about.currentlyValue}</span>
      <span><strong>{t.about.location}</strong> {t.about.locationValue}</span>
      <span><strong>{t.about.languages}</strong> {t.about.languagesValue}</span>
    </div>
  </div>
</section>
