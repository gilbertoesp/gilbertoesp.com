---
import type { Locale } from "../lib/i18n";

interface Props {
  code: Locale;
}

const { code } = Astro.props;

const flags: Record<string, string> = {
  en: `<rect width="16" height="12" rx="2.5" fill="#B22234"/><rect y="2.4" width="16" height="1.8" fill="#fff"/><rect y="6" width="16" height="1.8" fill="#fff"/><rect y="9.6" width="16" height="1.8" fill="#fff"/><rect width="6.6" height="6.6" rx="1" fill="#3C3B6E"/><circle cx="1.2" cy="1.2" r=".55" fill="#fff"/><circle cx="2.6" cy="1.2" r=".55" fill="#fff"/><circle cx="4" cy="1.2" r=".55" fill="#fff"/><circle cx="5.4" cy="1.2" r=".55" fill="#fff"/><circle cx="1.9" cy="2.7" r=".55" fill="#fff"/><circle cx="3.3" cy="2.7" r=".55" fill="#fff"/><circle cx="4.7" cy="2.7" r=".55" fill="#fff"/><circle cx="1.2" cy="4.2" r=".55" fill="#fff"/><circle cx="2.6" cy="4.2" r=".55" fill="#fff"/><circle cx="4" cy="4.2" r=".55" fill="#fff"/><circle cx="5.4" cy="4.2" r=".55" fill="#fff"/><circle cx="1.9" cy="5.7" r=".55" fill="#fff"/><circle cx="3.3" cy="5.7" r=".55" fill="#fff"/><circle cx="4.7" cy="5.7" r=".55" fill="#fff"/>`,
  es: `<rect width="16" height="12" rx="2.5" fill="#AA151B"/><rect y="4.5" width="16" height="3" fill="#F1BF00"/>`,
  zh: `<rect width="16" height="12" rx="2.5" fill="#DE2910"/><polygon points="2.5,1.9 3.1,3.3 4.5,3.3 3.4,4.1 3.8,5.5 2.5,4.7 1.2,5.5 1.6,4.1 0.5,3.3 1.9,3.3" fill="#FFDE00"/><circle cx="5.6" cy="2.4" r=".5" fill="#FFDE00"/><circle cx="6.6" cy="3.4" r=".5" fill="#FFDE00"/><circle cx="6.6" cy="4.7" r=".5" fill="#FFDE00"/><circle cx="5.6" cy="5.7" r=".5" fill="#FFDE00"/>`,
  pt: `<rect width="16" height="12" rx="2.5" fill="#009739"/><polygon points="8,1.8 14,6 8,10.2 2,6" fill="#FEDD00"/><circle cx="8" cy="6" r="2.3" fill="#002776"/><circle cx="8" cy="6" r="1.1" fill="#fff"/>`,
  fr: `<rect width="16" height="12" rx="2.5" fill="#fff"/><rect width="5.4" height="12" rx="2.5" fill="#0055A4"/><rect x="10.6" width="5.4" height="12" rx="2.5" fill="#EF4135"/>`,
};
---

<svg
  class="flag"
  viewBox="0 0 16 12"
  width="20"
  height="15"
  aria-hidden="true"
  set:html={flags[code] ?? ""}
/>
