---
import { socials } from "../lib/constants";
import type { Translation } from "../lib/i18n";

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<footer class="footer" id="contact">
  <div class="container">
    <h2 class="footer-title reveal">{t.footer.title}</h2>

    <div class="footer-socials reveal">
      <a class="link-primary" href={socials.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href={socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href={socials.x} target="_blank" rel="noopener noreferrer">X</a>
    </div>

    <div class="footer-bottom reveal">
      <span>&copy; 2026 Gilberto Esp</span>
      <span>{t.footer.builtWith}</span>
    </div>
  </div>
</footer>
