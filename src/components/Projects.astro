---
import { getLatestProjects } from "../lib/github";
import type { Translation } from "../lib/i18n";

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const projects = await getLatestProjects();
---

<section id="projects" class="section">
  <div class="container">
    <p class="sec-label reveal"><span>//</span> {t.sections.projectsLabel}</p>
    <h2 class="sec-title reveal">{t.sections.projectsTitle}</h2>

    <div class="projects">
      {projects.map((p) => (
        <a class="project-card reveal" href={p.link} target="_blank" rel="noopener noreferrer">
          <h3>{p.name}</h3>
          <p class="project-desc">{p.description}</p>
          <div class="project-tags">
            {p.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <span class="project-link">{p.link.replace(/^https?:\/\//, "")} &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
